# BAGLE FLIX — environment variables
#
# Copy this file to `.env.local` and fill in the real values there.
# `.env.local` is git-ignored and must NEVER be committed or pasted into chat.
# Every variable here must also be mirrored into
# Vercel → Project → Settings → Environment Variables.

# --- Supabase (Phase 1) ---------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bunny Stream (Phase 2) -----------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
# Used to mint short-lived signed playback tokens. Server-only.
BUNNY_TOKEN_AUTH_KEY=

# --- Stripe (Phase 4) -----------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Support assistant (Phase 5) ------------------------------------------
# console.anthropic.com → API keys. Without it, /support tells visitors the
# chat is unavailable rather than failing.
ANTHROPIC_API_KEY=

# --- App ------------------------------------------------------------------
# http://localhost:3000 locally, the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
